
import math

# Dataset
X = [1, 2, 3, 4, 5, 6]
Y = [0, 0, 0, 1, 1, 1]

# Initialize parameters
w = 0.0
b = 0.0
lr = 0.1

# Sigmoid function
def sigmoid(z):
    return 1 / (1 + math.exp(-z))

# Training
for epoch in range(5000):

    dw = 0
    db = 0

    for x, y in zip(X, Y):
        p = sigmoid(w * x + b)

        dw += (p - y) * x
        db += (p - y)

    w -= lr * dw / len(X)
    b -= lr * db / len(X)

# Prediction
print("LOGISTIC REGRESSION")
print("-------------------")

for x in X:
    p = sigmoid(w * x + b)
    result = 1 if p >= 0.5 else 0

    print("Input:", x,
          "Probability:", round(p, 3),
          "Class:", result)

# New sample
new_x = 4.5
p = sigmoid(w * new_x + b)

print("\nNew Sample:", new_x)
print("Predicted Class:", 1 if p >= 0.5 else 0)
