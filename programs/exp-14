
import numpy as np
from sklearn.linear_model import LinearRegression

# Dataset: Area and number of bedrooms
X = np.array([
    [1000, 2],
    [1200, 2],
    [1500, 3],
    [1800, 3],
    [2000, 4],
    [2200, 4],
    [2500, 5]
])

# House prices in lakhs
y = np.array([30, 35, 45, 50, 60, 65, 75])

# Train model
model = LinearRegression()
model.fit(X, y)

# New house details
new_house = [[1600, 3]]

# Prediction
price = model.predict(new_house)

print("HOUSE PRICE PREDICTION")
print("----------------------")
print("Area:", new_house[0][0], "sq.ft")
print("Bedrooms:", new_house[0][1])
print("Predicted Price:", round(price[0], 2), "Lakhs")
