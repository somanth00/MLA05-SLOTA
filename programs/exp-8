
# Dataset
X = [1, 2, 3, 4, 5]
Y = [2, 4, 6, 8, 10]

# Calculate means
mean_x = sum(X) / len(X)
mean_y = sum(Y) / len(Y)

# Calculate slope
numerator = sum(
    (X[i] - mean_x) * (Y[i] - mean_y)
    for i in range(len(X))
)

denominator = sum(
    (X[i] - mean_x) ** 2
    for i in range(len(X))
)

m = numerator / denominator

# Calculate intercept
c = mean_y - m * mean_x

# Regression equation
print("LINEAR REGRESSION")
print("-----------------")
print("Slope:", m)
print("Intercept:", c)
print("Equation: Y =", m, "* X +", c)

# Predict new value
new_x = 6
prediction = m * new_x + c

print("\nNew Input:", new_x)
print("Predicted Output:", prediction)
