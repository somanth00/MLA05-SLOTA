
import math

# Dataset
data = [
    ['Sunny', 'Weak', 'No'],
    ['Sunny', 'Strong', 'No'],
    ['Overcast', 'Weak', 'Yes'],
    ['Rain', 'Weak', 'Yes'],
    ['Rain', 'Strong', 'No'],
    ['Overcast', 'Strong', 'Yes'],
    ['Sunny', 'Weak', 'No'],
    ['Rain', 'Weak', 'Yes'],
    ['Sunny', 'Strong', 'No'],
    ['Overcast', 'Weak', 'Yes'],
    ['Rain', 'Strong', 'Yes'],
    ['Sunny', 'Weak', 'No']
]

train = data[:8]
test = data[8:]

classes = ['No', 'Yes']
features = [0, 1]

# Naive Bayes prediction
def predict(sample):
    scores = {}

    for c in classes:
        rows = [r for r in train if r[2] == c]
        score = math.log(len(rows) / len(train))

        for f in features:
            count = sum(1 for r in rows if r[f] == sample[f])
            values = set(r[f] for r in data)
            probability = (count + 1) / (len(rows) + len(values))
            score += math.log(probability)

        scores[c] = score

    return max(scores, key=scores.get)

# Predictions
actual = []
predicted = []

for row in test:
    actual.append(row[2])
    predicted.append(predict(row))

# Confusion Matrix
cm = [[0, 0], [0, 0]]

for a, p in zip(actual, predicted):
    i = classes.index(a)
    j = classes.index(p)
    cm[i][j] += 1

# Accuracy
correct = sum(1 for a, p in zip(actual, predicted) if a == p)
accuracy = (correct / len(actual)) * 100

# Display results
print("NAIVE BAYES CLASSIFICATION")
print("--------------------------")

print("\nActual Values:", actual)
print("Predicted Values:", predicted)

print("\nConfusion Matrix:")
print("       No  Yes")
print("No    ", cm[0])
print("Yes   ", cm[1])

print("\nAccuracy:", accuracy, "%")
