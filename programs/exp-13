
import numpy as np
from sklearn.linear_model import LinearRegression

# Dataset: Age of car and mileage
X = np.array([
    [1, 10000],
    [2, 20000],
    [3, 30000],
    [4, 40000],
    [5, 50000],
    [6, 60000],
    [7, 70000]
])

# Car prices in lakhs
y = np.array([9, 8, 7, 6, 5, 4, 3])

# Train model
model = LinearRegression()
model.fit(X, y)

# Predict car price
new_car = [[3, 25000]]
price = model.predict(new_car)

print("CAR PRICE PREDICTION")
print("--------------------")
print("Car Age:", new_car[0][0], "years")
print("Mileage:", new_car[0][1], "km")
print("Predicted Price:", round(price[0], 2), "Lakhs")
