
import numpy as np
from sklearn.linear_model import LinearRegression
from sklearn.preprocessing import PolynomialFeatures
from sklearn.metrics import r2_score

# Dataset
X = np.array([1, 2, 3, 4, 5, 6]).reshape(-1, 1)
y = np.array([2, 5, 10, 17, 26, 37])

# Linear Regression
linear = LinearRegression()
linear.fit(X, y)
linear_pred = linear.predict(X)

# Polynomial Regression
poly = PolynomialFeatures(degree=2)
X_poly = poly.fit_transform(X)

model = LinearRegression()
model.fit(X_poly, y)
poly_pred = model.predict(X_poly)

# Results
print("LINEAR AND POLYNOMIAL REGRESSION")
print("--------------------------------")
print("Linear R2 Score:", round(r2_score(y, linear_pred), 4))
print("Polynomial R2 Score:", round(r2_score(y, poly_pred), 4))

print("\nPredictions for X = 7")
print("Linear:", round(linear.predict([[7]])[0], 2))
print("Polynomial:", round(model.predict(
    poly.transform([[7]]))[0], 2))
