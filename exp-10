
import numpy as np
from sklearn.mixture import GaussianMixture

# Dataset
X = np.array([
    [1, 2], [1, 3], [2, 2],
    [8, 8], [9, 8], [8, 9]
])

# EM algorithm using Gaussian Mixture Model
model = GaussianMixture(
    n_components=2,
    random_state=42
)

model.fit(X)

# Predict clusters
labels = model.predict(X)

print("EXPECTATION MAXIMIZATION")
print("------------------------")
print("Cluster Labels:")

for i in range(len(X)):
    print(X[i], "-> Cluster", labels[i])

print("\nEM Algorithm Completed")
